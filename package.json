{
	"name": "slide-confirm",
	"version": "2.0.0-dev.0",
	"description": "Custom card for Home Assistant to prevent accidental button presses.",
	"author": "Brian Burton",
	"license": "MIT",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsbrianburton/slide-confirm.git"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component",
		"test:watch": "vitest",
		"check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"@vitest/browser-playwright": "^4.1.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-lit": "^2.3.1",
		"eslint-plugin-wc": "^3.1.0",
		"globals": "^16.0.0",
		"playwright": "^1.65.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^6.4.5",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"custom-card-helpers": "^1.9.0",
		"home-assistant-js-websocket": "^9.8.1",
		"lit": "^3.3.3"
	}
}
